# 싱크독_로컬 설정 — 이 파일을 .env로 복사해 채운다 (INSTALL.md 1).
# .env에는 비밀이 들어간다. 다른 사람에게 보내지 않는다.

# 반입한 이미지의 판. 묶음 이름의 판과 같다 — 업데이트할 때 이것만 바꾼다
SYNCDOC_VERSION=0

# 토큰 암호화·세션 서명 키. 길고 무작위한 문자열 — 예: openssl rand -base64 48
SECRET_KEY=
# DB 비밀번호. 처음 켜기 전에 정한다(나중에 바꾸면 DB가 옛 비밀번호로 남는다)
POSTGRES_PASSWORD=

# 나(로컬 사용자). 아이디는 커밋 작성자(local@syncdoc.local)에, 이름은 이력·설정에 보인다
LOCAL_LOGIN=local
LOCAL_NAME=

# 이 서버를 여는 주소. 새 프로젝트 README의 규약 링크(/specs)와 허용 주소에 쓰인다.
# 같은 망에 열 때만 바꾼다 (INSTALL.md 7)
PUBLIC_BASE_URL=http://127.0.0.1:8010

# 밀린 커밋 따라잡기 주기(초)
POLL_INTERVAL_SECONDS=300

# 질문 탭(선택) — 사내 OpenAI 호환 Chat Completions 주소. 주소나 키가 비면 탭이 없다 —
# 주소의 기본값이 없어 바깥으로 나가지 않는다. 키가 필요 없는 사내 서버면 키에 아무 값이나 넣는다
LLM_API_URL=
LLM_MODEL=
LLM_API_KEY=
