# syncdoc/config.py 가 읽는 환경 변수. 복사해서 .env 로 (.env 는 gitignore).
DATABASE_URL=postgresql+psycopg://syncdoc:syncdoc@localhost:5432/syncdoc
POSTGRES_PASSWORD=syncdoc

# GitHub 토큰 암호화 키. 길고 무작위한 문자열: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# 비밀키를 교체하는 중에만 채운다. 옛 키로도 복호화를 시도하고, 암호화는 늘 새 키로 (INFRA 5.1)
SECRET_KEY_OLD=

# 세션 쿠키 서명. 비우면 SECRET_KEY를 쓴다. 나눠 두면 토큰 키를 바꿔도 전원 로그아웃이 안 난다
SESSION_SECRET=

# GitHub OAuth 앱 (Settings → Developer settings → OAuth Apps). 콜백 URL은 {서버 주소}/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 싱크독이 만드는 GitHub 저장소를 비공개로 (기본 true). 공개로 만들려면 false로 명시한다.
# 이미 있는 저장소의 공개 여부는 바꾸지 않는다
GITHUB_REPO_PRIVATE=true

# 저장소 webhook(Settings → Webhooks, Payload URL {서버 주소}/hooks/github, content type application/json)의 Secret과 같은 값
WEBHOOK_SECRET=

# 공개 주소 (INFRA-001 5장). Named Tunnel 이면 고정 호스트(https://syncdoc.example.com)를 직접 적는다.
# Quick Tunnel 이면 비워 둔다 — scripts/tunnel.sh 가 켤 때마다 새 주소로 채운다
PUBLIC_BASE_URL=

# Cloudflare Named Tunnel 토큰 (Zero Trust → Networks → Tunnels → 터널 → 토큰). 비밀 — 채팅·커밋에 적지 않는다.
# 비우면 scripts/tunnel.sh 가 Quick Tunnel(도메인 없음, 주소 가변)로 뜬다
TUNNEL_TOKEN=

# 등록한 저장소의 작업 사본이 놓이는 곳
REPOS_DIR=/var/syncdoc/repos

# 서버 저장소(GitHub 없이 서버 안에 두는 저장소)와 보관 폴더(_archive/)가 놓이는 곳 (INFRA-001 5.2·6장).
# 서버 저장 프로젝트의 원본이다 — 볼륨으로 남기고 DB와 함께 백업한다
ORIGINS_DIR=/var/syncdoc/origins

# 이 서버에서 켠 저장 방식. 쉼표로 github,server 중 하나 이상. 둘 다면 프로젝트를 만들 때 고른다 (PRD R14)
STORAGE_MODES=github,server

# 외부 변경 폴링 주기(초). 0이면 폴링·기동 시 따라잡기를 끈다
POLL_INTERVAL_SECONDS=300

# 읽는 중 질의 (INFRA-001 5.3). 서버에 키 하나. 비우면 문서 뷰에서 질문 탭이 사라지고 나머지는 그대로 돈다.
# OpenAI 호환 Chat Completions — 주소·모델을 바꾸면 호환 서버(로컬 모델 등)도 된다
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o
# 한 대화에서 서버가 받는 최대 턴 수. 넘치면 앞을 잘라 보낸다
LLM_MAX_TURNS=10
# 판 (INFRA-001 8.1). closed면 폐쇄망판 — 로그인 없이 로컬 사용자 하나, 저장은 서버만.
# 폐쇄망 반입물은 scripts/release_closed.sh 가 release/closed/ 의 compose·.env 예시로 만든다
EDITION=internet
# 폐쇄망판 로컬 사용자 — 아이디는 커밋 작성자({아이디}@syncdoc.local), 이름은 이력·설정에 보인다
LOCAL_LOGIN=local
LOCAL_NAME=
